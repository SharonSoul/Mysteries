# ============================================================
# Autonomous Documentary Studio - Environment Configuration
# ============================================================
# Copy this file to .env and insert your actual credentials.
# NEVER commit your actual .env file to version control.

# --- ElevenLabs (Required for Narration) ---
# Your ElevenLabs API Key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Configured Voice ID (e.g., George, Adam, or custom documentary clone)
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Media APIs ---
# Pixabay API Key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Smithsonian Open Access API Key from https://open.si.edu/
SMITHSONIAN_API_KEY=your_smithsonian_api_key_here

# Openverse API (Optional - public endpoints available, token increases rate limits)
OPENVERSE_CLIENT_ID=your_openverse_client_id_here
OPENVERSE_CLIENT_SECRET=your_openverse_client_secret_here

# --- Application Configuration ---
# Target YouTube video mode: 'shorts' (9:16) or 'longform' (16:9)
DEFAULT_VIDEO_MODE=longform
LOG_LEVEL=INFO
